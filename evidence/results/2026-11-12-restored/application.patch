+def _combined_energy(local, cloud):
+    """Include both completed inference calls in an escalated request estimate."""
+    changes = {key: getattr(local, key) + getattr(cloud, key) for key in
+        ('tokens', 'joules', 'watt_hours', 'kilowatt_hours')}
+    for key in ('joules_min', 'joules_max', 'watt_hours_min', 'watt_hours_max',
+                'kilowatt_hours_min', 'kilowatt_hours_max'):
+        a, b = getattr(local, key), getattr(cloud, key)
+        changes[key] = a + b if a is not None and b is not None else None
+    return replace(cloud, **changes, average_power_w=None,
+        profile_label=local.profile_label + ' + ' + cloud.profile_label,
+        source=local.source + '; ' + cloud.source,
+        note='Combined configured estimates for local attempt and cloud response; not measured electricity.')
